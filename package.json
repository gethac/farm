{
  "name": "qq-classic-farm-mobile",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "node scripts/run-workspace-script.mjs apps/web dev --",
    "dev:server": "node scripts/run-workspace-script.mjs apps/server dev --",
    "test": "node node_modules/vitest/vitest.mjs run --pool threads --testTimeout 15000 apps/server/tests apps/web/src",
    "test:e2e": "node scripts/windows-ascii-runner.mjs -- \"playwright test\"",
    "build:workspaces": "npm run build --workspaces --if-present",
    "build": "node scripts/windows-ascii-runner.mjs -- \"npm run build:workspaces\""
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
